{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build project (WSL)",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "g++ -std=c++20 -fdiagnostics-color=always -g $(find \"${workspaceFolder}/src\" -name \"*.cpp\") -I \"${workspaceFolder}/src\" -o \"${workspaceFolder}/build/app\""
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": { "kind": "build", "isDefault": true },
            "detail": "Builds all sources using WSL"
        }
    ]
}
