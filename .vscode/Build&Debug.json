{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build & Debug (WSL)",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "g++ -std=c++20 -fdiagnostics-color=always -g $(find \"${workspaceFolder}/Libraries/Cpp\" -name \"*.cpp\") \"${workspaceFolder}/main.cpp\" -I \"${workspaceFolder}/Libraries/Header\" -o \"${workspaceFolder}/app\" && gdb -q --args \"${workspaceFolder}/app\""
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        }
    ]
}

